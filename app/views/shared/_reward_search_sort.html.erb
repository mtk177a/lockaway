<div class="card bg-base-100 w-full shadow-xl">
  <%= search_form_for @q, url: url, method: :get, class: "space-y-4 lg:space-y-0 p-4", data: { turbo_frame: "reward_list", controller: "form", action: "input->form#submit" } do |f| %>
    <div class="flex flex-col lg:flex-row lg:items-center lg:space-x-2">
      <!-- ソートセレクト -->
      <div class="px-2 py-1">
        <%= f.label :s, t('.sort_by'), class: "mr-2" %>
        <%= f.select :s, options_for_select([[t('.newest'), 'created_at desc'], [t('.oldest'), 'created_at asc']], params[:q]&.dig(:s)), {}, { class: "select select-bordered" } %>
      </div>

      <!-- 種類セレクト -->
      <div class="px-2 py-1">
        <%= f.label :habit_habit_type_eq, t('.habit_type'), class: "mr-2" %>
        <%= f.select :habit_habit_type_eq, options_for_select([[t('.all'), ''], [t('.good'), 'good'], [t('.bad'), 'bad']], params[:q]&.dig(:habit_habit_type_eq)), {}, { class: "select select-bordered" } %>
      </div>

      <!-- 名前検索フィールド（オートコンプリート） -->
      <div class="px-2 py-1 relative" data-controller="autocomplete" data-autocomplete-url-value="<%= search_user_rewards_path %>">
        <%= f.label :reward_name_cont, t('.search_by_name'), class: "mr-2" %>
        <%= f.text_field :reward_name_cont, value: params[:q]&.dig(:reward_name_cont), class: "input input-bordered", data: { autocomplete_target: "input" } %>
        <%= f.hidden_field :reward_id, data: { autocomplete_target: "hidden" } %>
        <ul class="list-group bg-white absolute w-full md:text-sm max-w-max z-10" data-autocomplete-target="results"></ul>
      </div>
    </div>
  <% end %>
</div>
