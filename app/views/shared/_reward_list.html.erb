<div class="list">
  <% if rewards.present? %>
    <% rewards.each do |habit_reward| %>
      <%= render partial: 'shared/reward_card', locals: { reward: habit_reward.reward, habit_reward: habit_reward } %>
    <% end %>
  <% else %>
    <p><%= t('rewards.index.no_rewards') %></p>
  <% end %>
</div>
